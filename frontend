<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Library Management System</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #222;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: auto;
            padding: 30px 0;
        }

        /* Header */

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        header h1 {
            margin: 0;
            font-size: 30px;
        }

        header p {
            color: #777;
        }

        button {
            border: none;
            padding: 11px 18px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 14px;
        }

        .add-btn {
            background: #2563eb;
            color: white;
        }

        .add-btn:hover {
            background: #1d4ed8;
        }

        /* Dashboard Cards */

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .card h3 {
            color: #666;
            margin-top: 0;
        }

        .card h2 {
            font-size: 32px;
            margin-bottom: 0;
        }

        /* Sections */

        .book-section,
        .form-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .section-header h2 {
            margin-bottom: 5px;
        }

        .section-header p {
            color: #777;
            margin-top: 0;
        }

        /* Search */

        #search {
            width: 300px;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 7px;
            font-size: 14px;
        }

        /* Table */

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 14px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #f8fafc;
        }

        /* Status */

        .available {
            color: #15803d;
            font-weight: bold;
            background: #dcfce7;
            padding: 6px 10px;
            border-radius: 15px;
        }

        .issued {
            color: #b91c1c;
            font-weight: bold;
            background: #fee2e2;
            padding: 6px 10px;
            border-radius: 15px;
        }

        /* Action Buttons */

        .edit {
            background: #6366f1;
            color: white;
            margin-right: 5px;
        }

        .delete {
            background: #dc2626;
            color: white;
        }

        /* Form */

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .form-grid input {
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 7px;
            font-size: 14px;
        }

        .form-grid input:focus,
        #search:focus {
            outline: none;
            border-color: #2563eb;
        }

        .available-check {
            display: block;
            margin-bottom: 20px;
        }

        .save-btn {
            background: #2563eb;
            color: white;
        }

        .cancel-btn {
            background: #6b7280;
            color: white;
            margin-left: 5px;
        }

        /* Mobile */

        @media (max-width: 768px) {

            .container {
                width: 95%;
                padding: 20px 0;
            }

            header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            header h1 {
                font-size: 25px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .section-header {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
            }

            #search {
                width: 100%;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }
        }

    </style>
</head>


<body>

<div class="container">

    <!-- HEADER -->

    <header>

        <div>
            <h1>📚 Library Management</h1>

            <p>
                Manage your library books easily
            </p>
        </div>

        <button
            class="add-btn"
            onclick="showForm()">

            + Add Book

        </button>

    </header>


    <!-- DASHBOARD -->

    <section class="stats">

        <div class="card">

            <h3>Total Books</h3>

            <h2 id="totalBooks">0</h2>

        </div>


        <div class="card">

            <h3>Available</h3>

            <h2 id="availableBooks">0</h2>

        </div>


        <div class="card">

            <h3>Issued</h3>

            <h2 id="issuedBooks">0</h2>

        </div>

    </section>


    <!-- BOOK COLLECTION -->

    <section class="book-section">

        <div class="section-header">

            <div>

                <h2>Book Collection</h2>

                <p>
                    View and manage all books
                </p>

            </div>


            <input
                type="text"
                id="search"
                placeholder="🔍 Search books..."
                onkeyup="displayBooks()">

        </div>


        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Book</th>

                        <th>Author</th>

                        <th>ISBN</th>

                        <th>Category</th>

                        <th>Year</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody id="bookTable">

                </tbody>

            </table>

        </div>

    </section>


    <!-- ADD / UPDATE FORM -->

    <section
        class="form-section"
        id="bookForm">

        <h2 id="formTitle">
            Add New Book
        </h2>


        <form onsubmit="saveBook(event)">

            <div class="form-grid">

                <input
                    type="text"
                    id="title"
                    placeholder="Book Title"
                    required>


                <input
                    type="text"
                    id="author"
                    placeholder="Author"
                    required>


                <input
                    type="text"
                    id="isbn"
                    placeholder="ISBN"
                    required>


                <input
                    type="text"
                    id="category"
                    placeholder="Category"
                    required>


                <input
                    type="number"
                    id="year"
                    placeholder="Published Year"
                    required>

            </div>


            <label class="available-check">

                <input
                    type="checkbox"
                    id="available"
                    checked>

                Book is available

            </label>


            <button
                type="submit"
                class="save-btn">

                Save Book

            </button>


            <button
                type="button"
                class="cancel-btn"
                onclick="resetForm()">

                Cancel

            </button>

        </form>

    </section>

</div>


<!-- JAVASCRIPT -->

<script>

    /*
        Django Backend API
    */

    const API_URL =
        "http://127.0.0.1:8000/api/books/";


    let editingId = null;


    // =========================
    // READ BOOKS
    // =========================

    async function displayBooks() {

        try {

            const response =
                await fetch(API_URL);


            if (!response.ok) {

                throw new Error(
                    "Backend error"
                );

            }


            const books =
                await response.json();


            const search =
                document
                .getElementById("search")
                .value
                .toLowerCase();


            const filteredBooks =
                books.filter(book =>

                    book.title
                    .toLowerCase()
                    .includes(search)

                    ||

                    book.author
                    .toLowerCase()
                    .includes(search)

                    ||

                    book.category
                    .toLowerCase()
                    .includes(search)

                    ||

                    book.isbn
                    .toLowerCase()
                    .includes(search)

                );


            const table =
                document
                .getElementById("bookTable");


            table.innerHTML = "";


            filteredBooks.forEach(book => {

                table.innerHTML += `

                    <tr>

                        <td>
                            #${book.id}
                        </td>


                        <td>
                            <strong>
                                ${book.title}
                            </strong>
                        </td>


                        <td>
                            ${book.author}
                        </td>


                        <td>
                            ${book.isbn}
                        </td>


                        <td>
                            ${book.category}
                        </td>


                        <td>
                            ${book.published_year}
                        </td>


                        <td>

                            <span class="${
                                book.available
                                ? "available"
                                : "issued"
                            }">

                                ${
                                    book.available
                                    ? "Available"
                                    : "Issued"
                                }

                            </span>

                        </td>


                        <td>

                            <button
                                class="edit"
                                onclick="editBook(${book.id})">

                                Edit

                            </button>


                            <button
                                class="delete"
                                onclick="deleteBook(${book.id})">

                                Delete

                            </button>

                        </td>

                    </tr>

                `;

            });


            updateDashboard(books);


        } catch (error) {

            console.error(error);

            alert(
                "Cannot connect to Django backend."
            );

        }

    }


    // =========================
    // DASHBOARD COUNTS
    // =========================

    function updateDashboard(books) {

        document
        .getElementById("totalBooks")
        .innerText =
            books.length;


        document
        .getElementById("availableBooks")
        .innerText =
            books.filter(
                book => book.available
            ).length;


        document
        .getElementById("issuedBooks")
        .innerText =
            books.filter(
                book => !book.available
            ).length;

    }


    // =========================
    // CREATE / UPDATE
    // =========================

    async function saveBook(event) {

        event.preventDefault();


        const book = {

            title:
                document
                .getElementById("title")
                .value
                .trim(),

            author:
                document
                .getElementById("author")
                .value
                .trim(),

            isbn:
                document
                .getElementById("isbn")
                .value
                .trim(),

            category:
                document
                .getElementById("category")
                .value
                .trim(),

            published_year:
                Number(
                    document
                    .getElementById("year")
                    .value
                ),

            available:
                document
                .getElementById("available")
                .checked

        };


        // Year validation

        if (
            book.published_year < 1000 ||
            book.published_year > 2100
        ) {

            alert(
                "Please enter a valid year."
            );

            return;

        }


        try {

            let response;


            // CREATE

            if (editingId === null) {

                response =
                    await fetch(
                        API_URL,
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(book)
                        }
                    );

            }


            // UPDATE

            else {

                response =
                    await fetch(
                        `${API_URL}${editingId}/`,
                        {
                            method: "PUT",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(book)
                        }
                    );

            }


            if (!response.ok) {

                const error =
                    await response.json();

                console.log(error);

                alert(
                    "Unable to save book. Check the entered details."
                );

                return;

            }


            alert(
                editingId === null
                ? "Book added successfully!"
                : "Book updated successfully!"
            );


            resetForm();

            displayBooks();


        } catch (error) {

            console.error(error);

            alert(
                "Backend server is not running."
            );

        }

    }


    // =========================
    // EDIT BOOK
    // =========================

    async function editBook(id) {

        try {

            const response =
                await fetch(
                    `${API_URL}${id}/`
                );


            const book =
                await response.json();


            document
            .getElementById("title")
            .value =
                book.title;


            document
            .getElementById("author")
            .value =
                book.author;


            document
            .getElementById("isbn")
            .value =
                book.isbn;


            document
            .getElementById("category")
            .value =
                book.category;


            document
            .getElementById("year")
            .value =
                book.published_year;


            document
            .getElementById("available")
            .checked =
                book.available;


            editingId = id;


            document
            .getElementById("formTitle")
            .innerText =
                "Update Book";


            document
            .getElementById("bookForm")
            .scrollIntoView({
                behavior: "smooth"
            });


        } catch (error) {

            alert(
                "Unable to load book."
            );

        }

    }


    // =========================
    // DELETE BOOK
    // =========================

    async function deleteBook(id) {

        const confirmDelete =
            confirm(
                "Do you want to delete this book?"
            );


        if (!confirmDelete) {

            return;

        }


        try {

            const response =
                await fetch(
                    `${API_URL}${id}/`,
                    {
                        method: "DELETE"
                    }
                );


            if (!response.ok) {

                throw new Error(
                    "Delete failed"
                );

            }


            alert(
                "Book deleted successfully!"
            );


            displayBooks();


        } catch (error) {

            alert(
                "Unable to delete book."
            );

        }

    }


    // =========================
    // SHOW FORM
    // =========================

    function showForm() {

        document
        .getElementById("bookForm")
        .scrollIntoView({
            behavior: "smooth"
        });

    }


    // =========================
    // RESET FORM
    // =========================

    function resetForm() {

        document
        .querySelector("form")
        .reset();


        document
        .getElementById("available")
        .checked = true;


        editingId = null;


        document
        .getElementById("formTitle")
        .innerText =
            "Add New Book";

    }


    // =========================
    // LOAD BOOKS
    // =========================

    displayBooks();

</script>

</body>
</html>
